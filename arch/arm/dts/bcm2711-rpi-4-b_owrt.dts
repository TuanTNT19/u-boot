&hdmi0 {
 status = "okay";
};

&hdmi1 {
 status = "okay";
};

&led_act {
 gpios = <&gpio 42 0>;
};

&leds {
 led_pwr: led-pwr {
  label = "PWR";
  gpios = <&expgpio 2 1>;
  default-state = "keep";
