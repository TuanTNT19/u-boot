 status = "okay";
};

&genet_mdio {
 phy1: ethernet-phy@1 {

  reg = <0x1>;
 };
};

&pcie0 {
 pci@0,0 {
  device_type = "pci";
  #address-cells = <3>;
  #size-cells = <2>;
  ranges;

  reg = <0 0 0 0 0>;

  usb@0,0 {
   reg = <0 0 0 0 0>;
   resets = <&reset 0>;
  };
 };
