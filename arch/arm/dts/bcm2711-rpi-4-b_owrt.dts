    brcm,pins = <4>;
    brcm,function = <4>;
   };
   gpclk1_gpio5: gpclk1-gpio5 {
    brcm,pins = <5>;
    brcm,function = <4>;
   };
   gpclk1_gpio42: gpclk1-gpio42 {
